<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ControlDiario" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="0" uuid="cd3df208-1f01-461e-9efe-3ee6c21a9dcb">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Intranet"/>
	<parameter name="LOGO_PATH" class="java.lang.Object"/>
	<parameter name="REPORT_DATE" class="java.sql.Date"/>
	<parameter name="ANO_FILTRO" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    m.descripcion AS presentacion,
    med.descripcionmedicamento AS descripcion_tableta,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 1 THEN cdm.cantidad ELSE 0 END) AS enero,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 2 THEN cdm.cantidad ELSE 0 END) AS febrero,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 3 THEN cdm.cantidad ELSE 0 END) AS marzo,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 4 THEN cdm.cantidad ELSE 0 END) AS abril,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 5 THEN cdm.cantidad ELSE 0 END) AS mayo,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 6 THEN cdm.cantidad ELSE 0 END) AS junio,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 7 THEN cdm.cantidad ELSE 0 END) AS julio,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 8 THEN cdm.cantidad ELSE 0 END) AS agosto,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 9 THEN cdm.cantidad ELSE 0 END) AS septiembre,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 10 THEN cdm.cantidad ELSE 0 END) AS octubre,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 11 THEN cdm.cantidad ELSE 0 END) AS noviembre,
    SUM(CASE WHEN EXTRACT(MONTH FROM cd.fecha_control) = 12 THEN cdm.cantidad ELSE 0 END) AS diciembre,
    SUM(cdm.cantidad) AS total_anual
FROM 
    control_diario_medicamento cdm
JOIN 
    control_diario cd ON cdm.uuid_control::text = cd.uuid_control::text
JOIN 
    medicamentos med ON cdm.uuid_medicamento::text = med.uuid_medicamento::text
JOIN 
    maestro m ON med.uuid_presentacion::text = m.uuid::text
WHERE 
    EXTRACT(YEAR FROM cd.fecha_control)::integer = $P{ANO_FILTRO}::integer
GROUP BY 
    m.descripcion, 
    med.descripcionmedicamento
ORDER BY 
    m.descripcion ASC, 
    med.descripcionmedicamento ASC]]>
	</queryString>
