<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ControlDiario" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryNewPage="true" uuid="cd3df208-1f01-461e-9efe-3ee6c21a9dcb">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="CentroMedico"/>
	<parameter name="LOGO_PATH" class="java.lang.Object"/>
	<parameter name="fechaInicio" class="java.sql.Date"/>
	<parameter name="fechaFin" class="java.sql.Date"/>
	<parameter name="REPORT_DATE" class="java.sql.Date"/>
	<parameter name="ANO_FILTRO" class="java.lang.String"/>
	<queryString language="plsql">
		<![CDATA[SELECT 
    m.descripcion AS presentacion,
    med.descripcionmedicamento AS descripcion_tableta,
    SUM(CASE WHEN EXTRACT(ISODOW FROM cd.fecha_control) = 1 THEN cdm.cantidad ELSE 0 END) AS lunes,
    SUM(CASE WHEN EXTRACT(ISODOW FROM cd.fecha_control) = 2 THEN cdm.cantidad ELSE 0 END) AS martes,
    SUM(CASE WHEN EXTRACT(ISODOW FROM cd.fecha_control) = 3 THEN cdm.cantidad ELSE 0 END) AS miercoles,
    SUM(CASE WHEN EXTRACT(ISODOW FROM cd.fecha_control) = 4 THEN cdm.cantidad ELSE 0 END) AS jueves,
    SUM(CASE WHEN EXTRACT(ISODOW FROM cd.fecha_control) = 5 THEN cdm.cantidad ELSE 0 END) AS viernes,
    SUM(cdm.cantidad) AS total_periodo
FROM 
    control_diario_medicamento cdm
JOIN 
    control_diario cd ON cdm.uuid_control = cd.uuid_control
JOIN 
    medicamentos med ON cdm.uuid_medicamento = med.uuid_medicamento
JOIN 
    maestro m ON med.uuid_presentacion = m.uuid
WHERE 
    cd.fecha_control >= $P{fechaInicio}::date
    AND cd.fecha_control <= $P{fechaFin}::date
    AND EXTRACT(ISODOW FROM cd.fecha_control) BETWEEN 1 AND 5
GROUP BY 
    m.descripcion, 
    med.descripcionmedicamento
ORDER BY 
    m.descripcion ASC, 
    med.descripcionmedicamento ASC;]]>
	</queryString>
	<field name="presentacion" class="java.lang.String"/>
	<field name="descripcion_tableta" class="java.lang.String"/>
	<field name="lunes" class="java.lang.Long"/>
	<field name="martes" class="java.lang.Long"/>
	<field name="miercoles" class="java.lang.Long"/>
	<field name="jueves" class="java.lang.Long"/>
	<field name="viernes" class="java.lang.Long"/>
	<field name="total_periodo" class="java.lang.Long"/>
	<variable name="sumaPresentacion" class="java.lang.Long" resetType="Group" resetGroup="GroupPresentacion" calculation="Sum">
		<variableExpression><![CDATA[$F{total_periodo}]]></variableExpression>
	</variable>
