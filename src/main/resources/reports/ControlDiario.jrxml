	<subDataset name="tableDataset" uuid="19567587-a257-4a46-99b9-f6c9fb258402">
		<queryString>
			<![CDATA[]]>
		</queryString>
	</subDataset>
	<parameter name="fecha" class="java.sql.Date"/>
	<parameter name="uuid_control" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.Object"/>
	<parameter name="REPORT_DATE" class="java.sql.Date"/>
	<parameter name="TURNO" class="java.lang.String">
		<defaultValueExpression><![CDATA["GENERAL"]]></defaultValueExpression>
	</parameter>
	<parameter name="MEDICO" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="MEDICO_NOMBRE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    cd.secuencia AS nro,
    to_char(cd.hora_control, 'HH24:MI') AS hora,
    t.cedula_titular AS cedula_titular,
    split_part(t.apellidos_titular, ' ', 1) || ' ' || split_part(t.nombre_titular, ' ', 1) AS titular_nombre_completo,
    mae_ente.descripcion AS ente,
    COALESCE(tf.cedula_familiar::text, '') AS cedula_familiar,
    COALESCE(split_part(tf.apellidos_familiar, ' ', 1) || ' ' || split_part(tf.nombres_familiar, ' ', 1), '') AS familiar_nombre_completo,
    COALESCE(mae_parent.descripcion, '') AS parentesco,
    m.apellidos_medico || ' ' || m.nombres_medico AS medico
FROM control_diario cd
JOIN titular t ON t.uuid_titular = cd.uuid_titular
LEFT JOIN titular_familiar tf ON tf.uuid_titular_familiar = cd.uuid_titular_fam
JOIN medicos m ON m.uuid_medico = cd.uuid_medico
JOIN maestro mae_ente ON mae_ente.uuid = t.uuid_organismo
LEFT JOIN maestro mae_parent ON mae_parent.uuid = tf.uuid_parentesco
WHERE 
    cd.fecha_control = $P{fecha}
    
    -- Filtro por TURNO
    AND (
        $P{TURNO} = 'GENERAL'
        OR ($P{TURNO} = 'MANANA' AND cd.hora_control BETWEEN '07:00'::time AND '12:00'::time)
        OR ($P{TURNO} = 'TARDE' AND cd.hora_control BETWEEN '13:00'::time AND '16:00'::time)
    )

    -- Filtro por MEDICO
    AND (
        $P{MEDICO} IS NULL 
        OR $P{MEDICO} = '' 
        OR m.uuid_medico::text = $P{MEDICO}
    )

ORDER BY cd.hora_control, cd.secuencia;]]>
	</queryString>
