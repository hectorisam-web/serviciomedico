	<parameter name="uuid_control" class="java.util.UUID"/>
	<queryString>
		<![CDATA[SELECT 
    cdm.uuid_control_med,
    cdm.uuid_control,
    cdm.uuid_medicamento,
    cdm.uuid_lote,
    cdm.cantidad,
    cdm.tratamiento,
    ml.numero_lote, 
    m.descripcionmedicamento, 
    p.descripcion AS presentacion,
    cd.fecha_control, 
    cd.hora_control,
    t.cedula_titular,
    tf.cedula_familiar,
    COALESCE(CAST(t.cedula_titular AS text), CAST(tf.cedula_familiar AS text)) AS cedula_beneficiario,
    
    -- Campos individuales
    t.nombre_titular AS nombres_beneficiario,
    t.apellidos_titular AS apellidos_beneficiario,
    tf.nombres_familiar AS nombre_familiar_detalle, 
    tf.apellidos_familiar AS apellido_familiar_detalle,
    
    -- Campo unificado seguro
    COALESCE(
        NULLIF(CONCAT(t.nombre_titular, ' ', t.apellidos_titular), ' '), 
        NULLIF(CONCAT(tf.nombres_familiar, ' ', tf.apellidos_familiar), ' ')
    ) AS nombre_completo_beneficiario,
    
    -- 1. Indicador fijo para el titular
    'T' AS indicador_titular,
    
    -- 2. Indicador exclusivo para el familiar (simplificado para evitar el conflicto del parser)
	REPLACE(COALESCE(CAST(cd.uuid_titular_fam AS varchar), ''), CAST(cd.uuid_titular_fam AS varchar), 'Fa') AS indicador_parentesco
FROM control_diario_medicamento cdm
JOIN control_diario cd ON cd.uuid_control = cdm.uuid_control
JOIN medicamentos m ON m.uuid_medicamento = cdm.uuid_medicamento
JOIN maestro p ON p.uuid = m.uuid_presentacion
LEFT JOIN medicamento_lotes ml ON ml.uuid_lote = cdm.uuid_lote
LEFT JOIN titular t ON t.uuid_titular = cd.uuid_titular
LEFT JOIN titular_familiar tf ON tf.uuid_titular_familiar = cd.uuid_titular_fam
LEFT JOIN maestro par ON par.uuid = tf.uuid_parentesco
WHERE cd.uuid_control = CAST($P{uuid_control} AS uuid)
ORDER BY cd.fecha_control DESC, cd.hora_control DESC]]>
	</queryString>
