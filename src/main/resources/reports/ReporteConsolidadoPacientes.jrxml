	<parameter name="LOGO_PATH" class="java.lang.Object"/>
	<parameter name="fechaInicio" class="java.sql.Date"/>
	<parameter name="fechaFin" class="java.sql.Date"/>
	<parameter name="REPORT_DATE" class="java.sql.Date"/>
	<queryString>
		<![CDATA[SELECT m.descripcion AS especialidad, 
        TO_CHAR(DATE_TRUNC('week', cd.fecha_control), 'DD/MM') || ' al ' || TO_CHAR(DATE_TRUNC('week', cd.fecha_control) + INTERVAL '4 day', 'DD/MM') AS numero_semana, 
        COUNT(cd.uuid_control) AS total_pacientes 
        FROM control_diario cd 
        JOIN medicos med ON cd.uuid_medico = med.uuid_medico 
        JOIN maestro m ON med.uuid_especialidad = m.uuid 
        WHERE cd.fecha_control BETWEEN $P{fechaInicio} AND $P{fechaFin} 
        GROUP BY m.descripcion, numero_semana ORDER BY m.descripcion ASC, numero_semana ASC]]>
	</queryString>
	<field name="especialidad" class="java.lang.String"/>
	<field name="numero_semana" class="java.lang.String"/>
	<field name="total_pacientes" class="java.lang.Long"/>
	<variable name="TOTAL_GENERAL" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{total_pacientes}]]></variableExpression>
	</variable>
