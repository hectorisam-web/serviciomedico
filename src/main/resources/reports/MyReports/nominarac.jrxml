	<queryString>
		<![CDATA[SELECT  max(g.cod_grupo_nomina) as codgno, max(g.nombre) as gruponomina, max(g.periodicidad) as periodicidad,
        max(d.nombre) as tipopersonal, max(d.cod_tipo_personal) as codtno,
        max(b.fecha_ingreso) as ingresoorganismo, b.codigo_nomina as codrac, max(b.estatus) as estatus,
        max(b.forma_pago) as formapago, max(b.cuenta_nomina) as cuenta_nomina,
	max(e.cedula) as codtra, e.primer_nombre as primer_nombre, e.segundo_nombre as segundo_nombre,
	e.primer_apellido as primer_apellido, e.segundo_apellido as segundo_apellido,
        k.cod_cargo as codigocargo, k.descripcion_cargo as cargo,
        j.cod_dependencia as codcen, j.nombre as nombreunidad, b.sueldo_basico as suebas,
        c.cod_concepto as codcon, c.descripcion as  descon, a.id_ultima_nomina as id_contador,
	a.unidades as unidades, a.monto_asigna as asigna, a.monto_deduce as deduce,
        a.documento_soporte as documento, max(i.cod_unidad_administ) as unidad,
        max(i.nombre) as nomunidad, k.grado as grado, fp.cod_frecuencia_pago as frecon
                      
  FROM ultimanomina a,   trabajador b, concepto c, tipoPersonal d, 
       personal e, conceptoTipoPersonal f, grupoNomina g, 
       unidadEjecutora h,dependencia j, cargo k,
       unidadadministradora i, administradorauel au,
       frecuenciaTipoPersonal ftp, frecuenciaPago fp
     
    WHERE a.id_grupo_nomina         	=  $P{id_grupo_nomina}
      AND a.numero_nomina 		=  $P{numero_nomina}
      AND g.id_grupo_nomina            	=  a.id_grupo_nomina
      AND d.id_tipo_personal             =  a.id_tipo_personal
      AND b.id_tipo_personal            =  d.id_tipo_personal
      AND b.id_trabajador      		=  a.id_trabajador
      AND e.id_personal		     	=  b.id_personal
      AND j.id_dependencia         	=  b.id_dependencia
      AND j.id_administradora_uel       =  au.id_administradora_uel
      AND h.id_unidad_ejecutora        	=  au.id_unidad_ejecutora
      AND k.id_cargo             	=  b.id_cargo
      AND f.id_concepto_tipo_personal	=  a.id_concepto_tipo_personal
      AND c.id_concepto                 =  f.id_concepto
      AND i.id_unidad_administradora    = au.id_unidad_administradora 
      AND a.id_frecuencia_tipo_personal = ftp.id_frecuencia_tipo_personal
      AND ftp.id_frecuencia_pago  = fp.id_frecuencia_pago

group by d.cod_tipo_personal, i.cod_unidad_administ,b.codigo_nomina, e.cedula, e.primer_nombre, e.segundo_nombre,
	e.primer_apellido, e.segundo_apellido, k.cod_cargo, k.descripcion_cargo, b.sueldo_basico,
        j.cod_dependencia, j.nombre, c.cod_concepto, c.descripcion, a.id_ultima_nomina,
	a.unidades, a.monto_asigna, a.monto_deduce,  a.documento_soporte,  k.grado, fp.cod_frecuencia_pago
          
order by  d.cod_tipo_personal,i.cod_unidad_administ, b.codigo_nomina, e.cedula, c.cod_concepto]]>
	</queryString>
