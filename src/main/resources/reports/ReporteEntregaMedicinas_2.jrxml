<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ControlMensualSemanasHorizontal" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="cd3df208-1f01-461e-9efe-3ee6c21a9dcb">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Intranet"/>
	<parameter name="LOGO_PATH" class="java.lang.Object"/>
	<parameter name="fechaInicio" class="java.sql.Date"/>
	<parameter name="fechaFin" class="java.sql.Date"/>
	<parameter name="REPORT_DATE" class="java.sql.Date"/>
	<parameter name="ANO_FILTRO" class="java.lang.String"/>
	<parameter name="p_sem1" class="java.lang.String"/>
	<parameter name="p_sem2" class="java.lang.String"/>
	<parameter name="p_sem3" class="java.lang.String"/>
	<parameter name="p_sem4" class="java.lang.String"/>
	<parameter name="p_sem5" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH dias_laborales AS (
    SELECT 
        cd.uuid_control,
        cd.fecha_control,
        -- Asigna el número de semana del mes basándose en el Lunes de cada semana calendario
        DENSE_RANK() OVER (
            PARTITION BY DATE_TRUNC('month', cd.fecha_control) 
            ORDER BY DATE_TRUNC('week', cd.fecha_control)
        ) AS semana_laboral
    FROM 
        control_diario cd
    WHERE 
        EXTRACT(ISODOW FROM cd.fecha_control) BETWEEN 1 AND 5 -- Solo Lunes a Viernes
        AND cd.fecha_control >= $P{fechaInicio}::date
        AND cd.fecha_control <= $P{fechaFin}::date
)
SELECT 
    m.descripcion AS presentacion,
    med.descripcionmedicamento AS descripcion_tableta,
    SUM(CASE WHEN dl.semana_laboral = 1 THEN cdm.cantidad ELSE 0 END) AS semana_1,
    SUM(CASE WHEN dl.semana_laboral = 2 THEN cdm.cantidad ELSE 0 END) AS semana_2,
    SUM(CASE WHEN dl.semana_laboral = 3 THEN cdm.cantidad ELSE 0 END) AS semana_3,
    SUM(CASE WHEN dl.semana_laboral = 4 THEN cdm.cantidad ELSE 0 END) AS semana_4,
    SUM(CASE WHEN dl.semana_laboral >= 5 THEN cdm.cantidad ELSE 0 END) AS semana_5,
    SUM(cdm.cantidad) AS total_periodo
FROM 
    control_diario_medicamento cdm
JOIN 
    dias_laborales dl ON cdm.uuid_control::text = dl.uuid_control::text
JOIN 
    medicamentos med ON cdm.uuid_medicamento::text = med.uuid_medicamento::text
JOIN 
    maestro m ON med.uuid_presentacion::text = m.uuid::text
GROUP BY 
    m.descripcion, 
    med.descripcionmedicamento
ORDER BY 
    m.descripcion ASC, 
    med.descripcionmedicamento ASC;]]>
	</queryString>
