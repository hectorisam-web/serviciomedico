	<parameter name="LOGO_PATH" class="java.lang.Object"/>
	<parameter name="fechaInicio" class="java.sql.Date"/>
	<parameter name="fechaFin" class="java.sql.Date"/>
	<parameter name="REPORT_DATE" class="java.sql.Date"/>
	<parameter name="ANO_FILTRO" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    m.descripcion AS especialidad,
    s.orden || ' - ' || 
    CASE s.orden
        WHEN 1 THEN 'Enero'
        WHEN 2 THEN 'Febrero'
        WHEN 3 THEN 'Marzo'
        WHEN 4 THEN 'Abril'
        WHEN 5 THEN 'Mayo'
        WHEN 6 THEN 'Junio'
        WHEN 7 THEN 'Julio'
        WHEN 8 THEN 'Agosto'
        WHEN 9 THEN 'Septiembre'
        WHEN 10 THEN 'Octubre'
        WHEN 11 THEN 'Noviembre'
        WHEN 12 THEN 'Diciembre'
    END AS numero_semana,
    COALESCE(COUNT(cd.uuid_control), 0) AS total_pacientes,
    s.orden
FROM (
    SELECT 
        (make_date($P{ANO_FILTRO}::integer, 1, 1) + ((n - 1) || ' month')::interval)::date AS inicio,
        (make_date($P{ANO_FILTRO}::integer, 1, 1) + (n || ' month')::interval - interval '1 day')::date AS fin,
        n AS orden
    FROM generate_series(1, 12) n
) s
CROSS JOIN (
    SELECT DISTINCT maestro.uuid, maestro.descripcion 
    FROM maestro 
    JOIN medicos ON medicos.uuid_especialidad = maestro.uuid
) m
LEFT JOIN medicos med ON med.uuid_especialidad = m.uuid
LEFT JOIN control_diario cd ON cd.uuid_medico = med.uuid_medico 
    AND EXTRACT(YEAR FROM cd.fecha_control)::integer = $P{ANO_FILTRO}::integer
    AND cd.fecha_control BETWEEN s.inicio AND s.fin
GROUP BY m.descripcion, s.inicio, s.fin, s.orden
ORDER BY s.orden ASC, m.descripcion ASC;]]>
	</queryString>
