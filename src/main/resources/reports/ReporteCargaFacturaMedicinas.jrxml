	<parameter name="fecha" class="java.sql.Date"/>
	<parameter name="NUMERO_FACTURA" class="java.lang.String"/>
	<parameter name="FECHA_FACTURA" class="java.sql.Date"/>
	<parameter name="LOGO_PATH" class="java.lang.Object"/>
	<parameter name="REPORT_DATE" class="java.sql.Date"/>
	<parameter name="uuid" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    f.numero_factura AS numeroFactura,
    f.fecha_factura AS fechaFactura,
    f.proveedor AS proveedor,
    f.observaciones AS observaciones,
    f.activo AS facturaActiva,
    l.uuid_medicamento AS uuidMedicamento,
    l.numero_lote AS numerolote,
    l.stock_inicial AS stockInicial,
    l.stock_disponible AS stockdisponible,
    l.fecha_vencimiento AS fechavencimiento,
    m.descripcionmedicamento AS medicamento,
    p.descripcion AS descripcionPresentacion
FROM factura f
JOIN medicamento_lotes l ON l.uuid_factura = f.uuid_factura
JOIN medicamentos m ON m.uuid_medicamento = l.uuid_medicamento
LEFT JOIN maestro p ON p.uuid = m.uuid_presentacion
WHERE f.uuid_factura = CAST($P{uuid} AS uuid)]]>
	</queryString>
