	<variable name="EdadExacta" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[$F{fecha_nacimiento} == null ?
        0 :
        java.time.Period.between(
            $F{fecha_nacimiento}.toLocalDate(),
            java.time.LocalDate.now()
        ).getYears()]]></variableExpression>
	</variable>
	<variable name="HistoriaFinal" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[$V{EdadExacta} < 18 ?
            $F{historia_titular} :
            (
                $F{historia_familiar} != null && !$F{historia_familiar}.isEmpty() ?
                    $F{historia_familiar} :
                    $F{historia_titular}
            )]]></variableExpression>
	</variable>
	<variable name="EsFamiliar" class="java.lang.Boolean" resetType="None">
		<variableExpression><![CDATA[($F{nombres_familiar} != null)
        || ($F{cedula_paciente} == null)
        || ($F{cedula_paciente}.toString().length() < 7)
        || ($V{EdadExacta} < 18)]]></variableExpression>
	</variable>
