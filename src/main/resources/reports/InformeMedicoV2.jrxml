<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="InformeMedico" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="344ab321-0f46-4d98-b7ce-8cba6f9fbdbd">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Intranet"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="478"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="522"/>
	<parameter name="uuidControl" class="java.lang.String"/>
	<parameter name="LOGO_CONSULTA" class="java.lang.Object"/>
	<parameter name="LOGO_TURISMO" class="java.lang.Object"/>
	<queryString>
		<![CDATA[SELECT 
    cd.uuid_control,
    cd.secuencia,
    cd.fecha_control,
    cd.hora_control,
    cd.peso_kg,
    cd.tension_sistolica,
    cd.tension_diastolica,
    cd.talla_cm,
    cd.temperatura,
    cd.motivo_consulta,
    cd.diagnostico,
    cd.indicaciones,
    cd.observaciones,

    -- Datos del familiar (si existe)
    tf.nombres_familiar,
    tf.apellidos_familiar,
    tf.cedula_familiar,
    tf.fecha_nac_familiar,
    tf.numero_historia AS historia_familiar,

    -- Datos del titular
    t.nombre_titular,
    t.apellidos_titular,
    t.cedula_titular,
    t.fecha_nacimiento AS fecha_nac_titular,
    t.nro_historia AS historia_titular,

    -- Organismo del titular
    org.descripcion AS organismo,

    -- Paciente final
    COALESCE(tf.nombres_familiar, t.nombre_titular) AS nombres_paciente,
    COALESCE(tf.apellidos_familiar, t.apellidos_titular) AS apellidos_paciente,
    COALESCE(tf.cedula_familiar, t.cedula_titular) AS cedula_paciente,
    COALESCE(tf.fecha_nac_familiar, t.fecha_nacimiento) AS fecha_nacimiento,
    COALESCE(tf.numero_historia, t.nro_historia) AS numero_historia,

    -- Médico
    m.nombres_medico,
    m.apellidos_medico,
    m.cedula_medico,
    m.mpps

FROM control_diario cd
LEFT JOIN titular_familiar tf 
    ON tf.uuid_titular_familiar = cd.uuid_titular_fam
LEFT JOIN titular t 
    ON t.uuid_titular = cd.uuid_titular
LEFT JOIN maestro org
    ON org.uuid = t.uuid_organismo
JOIN medicos m 
    ON m.uuid_medico = cd.uuid_medico
WHERE ($P{uuidControl} IS NOT NULL AND cd.uuid_control = CAST($P{uuidControl} AS uuid))]]>
	</queryString>
