<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ConsolidadoPresentacion" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1b2c3d4-1111-2222-3333-444455556666">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="CentroMedico"/>
	<parameter name="fechaInicio" class="java.sql.Date"/>
	<parameter name="fechaFin" class="java.sql.Date"/>
	<queryString>
		<![CDATA[SELECT 
    m.descripcion AS presentacion,
    SUM(cdm.cantidad) AS total_presentacion
FROM 
    control_diario_medicamento cdm
JOIN 
    control_diario cd ON cdm.uuid_control = cd.uuid_control
JOIN 
    medicamentos med ON cdm.uuid_medicamento = med.uuid_medicamento
JOIN 
    maestro m ON med.uuid_presentacion = m.uuid
WHERE 
    cd.fecha_control >= $P{fechaInicio}::date
    AND cd.fecha_control <= $P{fechaFin}::date
    AND EXTRACT(ISODOW FROM cd.fecha_control) BETWEEN 1 AND 5
GROUP BY 
    m.descripcion
ORDER BY 
    m.descripcion ASC;]]>
	</queryString>
	<field name="presentacion" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="presentacion"/>
		<property name="com.jaspersoft.studio.field.label" value="presentacion"/>
	</field>
	<field name="total_presentacion" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="total_presentacion"/>
		<property name="com.jaspersoft.studio.field.label" value="total_presentacion"/>
	</field>
	<variable name="granTotalConsolidado" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{total_presentacion}]]></variableExpression>
	</variable>
