		<defaultValueExpression><![CDATA["2026/09/31"]]></defaultValueExpression>
	</parameter>
	<parameter name="TRIMESTRE" class="java.lang.String">
		<defaultValueExpression><![CDATA["3"]]></defaultValueExpression>
	</parameter>
	<parameter name="ANO_FILTRO" class="java.lang.String">
		<defaultValueExpression><![CDATA["2026"]]></defaultValueExpression>
	</parameter>
	<parameter name="LBL_SEM_1" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/07-05/07"]]></defaultValueExpression>
