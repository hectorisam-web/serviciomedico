	<queryString>
		<![CDATA[SELECT 
    m.descripcion AS presentacion,
    med.descripcionmedicamento AS descripcion_tableta,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 1 THEN cdm.cantidad ELSE 0 END) AS sem_1,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 2 THEN cdm.cantidad ELSE 0 END) AS sem_2,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 3 THEN cdm.cantidad ELSE 0 END) AS sem_3,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 4 THEN cdm.cantidad ELSE 0 END) AS sem_4,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 5 THEN cdm.cantidad ELSE 0 END) AS sem_5,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 6 THEN cdm.cantidad ELSE 0 END) AS sem_6,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 7 THEN cdm.cantidad ELSE 0 END) AS sem_7,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 8 THEN cdm.cantidad ELSE 0 END) AS sem_8,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 9 THEN cdm.cantidad ELSE 0 END) AS sem_9,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 10 THEN cdm.cantidad ELSE 0 END) AS sem_10,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 11 THEN cdm.cantidad ELSE 0 END) AS sem_11,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 12 THEN cdm.cantidad ELSE 0 END) AS sem_12,
    SUM(CASE WHEN (EXTRACT(WEEK FROM cd.fecha_control)::integer - (CASE WHEN $P{TRIMESTRE}::integer = 1 THEN 0 WHEN $P{TRIMESTRE}::integer = 2 THEN 13 WHEN $P{TRIMESTRE}::integer = 3 THEN 26 WHEN $P{TRIMESTRE}::integer = 4 THEN 39 END)) = 13 THEN cdm.cantidad ELSE 0 END) AS sem_13,
    SUM(cdm.cantidad) AS total_periodo
FROM 
    control_diario_medicamento cdm
JOIN 
    control_diario cd ON cdm.uuid_control::text = cd.uuid_control::text
JOIN 
    medicamentos med ON cdm.uuid_medicamento::text = med.uuid_medicamento::text
JOIN 
    maestro m ON med.uuid_presentacion::text = m.uuid::text
WHERE 
    EXTRACT(YEAR FROM cd.fecha_control)::integer = $P{ANO_FILTRO}::integer
    AND cd.fecha_control >= 
        CASE 
            WHEN $P{TRIMESTRE}::integer = 1 THEN make_date($P{ANO_FILTRO}::integer, 1, 1)
            WHEN $P{TRIMESTRE}::integer = 2 THEN make_date($P{ANO_FILTRO}::integer, 4, 1)
            WHEN $P{TRIMESTRE}::integer = 3 THEN make_date($P{ANO_FILTRO}::integer, 7, 1)
            WHEN $P{TRIMESTRE}::integer = 4 THEN make_date($P{ANO_FILTRO}::integer, 10, 1)
        END
    AND cd.fecha_control <= 
        CASE 
            WHEN $P{TRIMESTRE}::integer = 1 THEN make_date($P{ANO_FILTRO}::integer, 3, 31)
            WHEN $P{TRIMESTRE}::integer = 2 THEN make_date($P{ANO_FILTRO}::integer, 6, 30)
            WHEN $P{TRIMESTRE}::integer = 3 THEN make_date($P{ANO_FILTRO}::integer, 9, 30)
            WHEN $P{TRIMESTRE}::integer = 4 THEN make_date($P{ANO_FILTRO}::integer, 12, 31)
        END
    AND EXTRACT(ISODOW FROM cd.fecha_control) BETWEEN 1 AND 5
GROUP BY 
    m.descripcion, 
    med.descripcionmedicamento
ORDER BY 
    m.descripcion ASC, 
    med.descripcionmedicamento ASC;]]>
	</queryString>
